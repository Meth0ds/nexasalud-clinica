# Copying this file verbatim is not enough to start the stack.
# Run ./scripts/init.sh to create infra/.env with random local-only secrets.
COMPOSE_PROJECT_NAME=nexasalud-local

API_HTTP_PORT=8000
KEYCLOAK_HTTP_PORT=8080
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

APP_KEY=CHANGE_ME_GENERATED_BY_INIT
APP_DEBUG=false
RUN_MIGRATIONS=true
DEMO_PORTAL_SIMULATIONS=true
CLINICAL_PDF_ASYNC=false
CLINICAL_PDF_QUEUE=clinical-pdf
CLINICAL_PDF_TIMEOUT_SECONDS=60
CLINICAL_PDF_RETRY_AFTER_SECONDS=90
CLINICAL_PDF_MAX_ATTEMPTS=3
CLINICAL_PDF_MAX_PENDING_PER_ACTOR=3
CLINICAL_PDF_MAX_CONCURRENT_PER_CLINIC=1
CLINICAL_PDF_POLL_AFTER_SECONDS=2

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
POSTGRES_DB=nexasalud
APP_DB_USERNAME=nexasalud_app
APP_DB_PASSWORD=CHANGE_ME_GENERATED_BY_INIT

REDIS_PASSWORD=CHANGE_ME_GENERATED_BY_INIT

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak_app
KEYCLOAK_DB_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local_admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_GENERATED_BY_INIT
KEYCLOAK_CLIENT_ID=nexasalud-bff
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_GENERATED_BY_INIT
KEYCLOAK_DEMO_CLINICIAN_PASSWORD=
KEYCLOAK_DEMO_RECEPTIONIST_PASSWORD=
KEYCLOAK_DEMO_AUDITOR_PASSWORD=
KEYCLOAK_DEMO_PATIENT_PASSWORD=
