  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "webAuthnPolicyCreateTimeout": 0,
  "webAuthnPolicyAvoidSameAuthenticatorRegister": true,
  "authenticatorConfig": [
    {
      "alias": "NexaSalud LoA 1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "900"
      }
    },
    {
      "alias": "NexaSalud LoA 2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "NexaSalud Password AMR",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "900"
      }
    },
    {
      "alias": "NexaSalud OTP AMR",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "900"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "NexaSalud Browser MFA",
      "description": "Flujo local de alta seguridad: contraseña y TOTP obligatorios con LoA 2.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "NexaSalud Browser MFA Forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "NexaSalud Browser MFA Forms",
      "description": "Subflujo que alcanza LoA 1 con contraseña y LoA 2 con TOTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "NexaSalud Password LoA 1",
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "NexaSalud OTP LoA 2",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "NexaSalud Password LoA 1",
      "description": "Primer factor: DNI y contraseña.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "NexaSalud LoA 1",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "NexaSalud Password AMR",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "NexaSalud OTP LoA 2",
      "description": "Segundo factor obligatorio: código TOTP de un solo uso.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "NexaSalud LoA 2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "NexaSalud OTP AMR",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
